{{ if eq .chezmoi.hostname "relboron" -}}
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1 })
hl.monitor({ output = "eDP-1", mode = "2560x1600@60.00100", position = "-1000x0", scale = 1.6, transform = 3 })
hl.monitor({ output = "HDMI-A-1", mode = "2560x1440@59.95100", position = "auto-right", scale = 1 })
{{ else if eq .chezmoi.hostname "xenthorium" -}}
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1.25 })
hl.monitor({ output = "HDMI-A-4", mode = "3840x2160@120.00000", position = "auto-left", scale = 1.25 })
hl.monitor({ output = "DP-4", mode = "3840x2160@59.99700", position = "auto-right", scale = 1.25 })
{{ else -}}
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1 })
{{ end -}}
