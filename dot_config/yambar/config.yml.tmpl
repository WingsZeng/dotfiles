{{- $host := .chezmoi.hostname -}}
{{- $knownHosts := list "xenthorium" "relboron" -}}
{{- $batteryHosts := list "relboron" -}}
{{- $wifiHosts := list "xenthorium" "relboron" -}}
{{- $bigSizeHosts := list "xenthorium" -}}
{{- $wiredInterfaces := dict "xenthorium" "eno1" "relboron" "enp0s31f6" -}}
{{- $unknown := not (has $host $knownHosts) -}}
{{- $hasBattery := has $host $batteryHosts -}}
{{- $hasWifi := has $host $wifiHosts -}}
{{- $bigSize := has $host $bigSizeHosts -}}
{{- $wired := get $wiredInterfaces $host -}}
{{- $xenthorium := eq $host "xenthorium" -}}
{{- $relboron := eq $host "relboron" -}}
color:
  red: &red f92672ff
  green: &green a6e22eff
  yellow: &yellow e6db74ff
  orange: &orange fd971fff
  purple: &purple ae81ffff
  blue: &blue 66d9efff
  write: &write f8f8f2ff
  black: &black 222222ff
  gray: &gray a9a9b3ff

  prompt_color: &prompt_color f8f8f2ff

delimiter_str: &delimiter_str
  string: {text: "┃", foreground: 444444ff}

delimiter: &delimiter
  label:
    content:
      *delimiter_str

prompt_font: &prompt_font "UbuntuMono Nerd Font:style=bold:size={{ if $bigSize }}64{{ else }}32{{ end }}"

bar:
  height: {{ if $bigSize }}64{{ else }}32{{ end }}
  location: top
  layer: top
  background: 00000000
  foreground: *write
  margin: {{ if $bigSize }}40{{ else }}20{{ end }}
  spacing: {{ if $bigSize }}16{{ else }}8{{ end }}
  font: "UbuntuMono Nerd Font:size={{ if $bigSize }}56{{ else }}28{{ end }}"

  left:

    - label:
        content:
          string: {text: cpu, foreground: *prompt_color, font: *prompt_font}
    - cpu:
        poll-interval: 1000
        content:
          map:
            conditions:
              id < 0:
                map:
                  default:
                    - string: {text: "{cpu}%"}
                  conditions:
                    cpu >= 90:
                      - string: {text: "{cpu}%", foreground: *red}

    - *delimiter

    - label:
        content:
          string: {text: mem, foreground: *prompt_color, font: *prompt_font}
    - mem:
        poll-interval: 1000
        content:
          map:
            default:
              - string: {text: "{percent_used}%"}
            conditions:
              percent_used >= 80:
                - string: {text: "{percent_used}%", foreground: *red}
              percent_used >= 60:
                - string: {text: "{percent_used}%", foreground: *yellow}

{{ if not $unknown }}
    - network:
        poll-interval: 1000
        content:
          map:
            default: {empty: {}}
            conditions:
              name == {{ $wired }}:
                map:
                  default: {empty: {}}
                  conditions:
                    state == up && ipv4 != "":
                    - *delimiter_str

    - network:
        poll-interval: 1000
        content:
          map:
            default: {empty: {}}
            conditions:
              name == {{ $wired }}:
                map:
                  default: {empty: {}}
                  conditions:
                    state == up && ipv4 != "":
                    - string: {text: "eth", foreground: *prompt_color, font: *prompt_font}

    - network:
        poll-interval: 1000
        content:
          map:
            default: {empty: {}}
            conditions:
              name == {{ $wired }}:
                map:
                  default: {empty: {}}
                  conditions:
                    state == up && ipv4 != "":
                    - string: {text: "{{ if $xenthorium }}{dl-speed:mb} {ul-speed:mb}{{ else }}{dl-speed:mb}{{ end }}"}

{{ if $relboron }}
    - network:
        poll-interval: 1000
        content:
          map:
            default: {empty: {}}
            conditions:
              name == {{ $wired }}:
                map:
                  default: {empty: {}}
                  conditions:
                    state == up && ipv4 != "":
                    - string: {text: "{ul-speed:mb}"}
{{ end }}

{{ end }}
{{ if $hasWifi }}
    - network:
        poll-interval: 1000
        content:
          map:
            default: {empty: {}}
            conditions:
              name == wlan0:
                map:
                  default: {empty: {}}
                  conditions:
                    state == up && ipv4 != "":
                    - *delimiter_str

    - network:
        poll-interval: 1000
        content:
          map:
            default: {empty: {}}
            conditions:
              name == wlan0:
                map:
                  default: {empty: {}}
                  conditions:
                    state == up && ipv4 != "":
                    - string: {text: "wlan", foreground: *prompt_color, font: *prompt_font}

{{ if $relboron }}
    - network:
        poll-interval: 1000
        content:
          map:
            default: {empty: {}}
            conditions:
              name == wlan0:
                map:
                  default: {empty: {}}
                  conditions:
                    state == up && ipv4 != "":
                    - string: {text: "{ssid}"}
{{ end }}

    - network:
        poll-interval: 1000
        content:
          map:
            default: {empty: {}}
            conditions:
              name == wlan0:
                map:
                  default: {empty: {}}
                  conditions:
                    state == up && ipv4 != "":
                    - string: {text: "{{ if $xenthorium }}{dl-speed:mb} {ul-speed:mb}{{ else }}{dl-speed:mb}{{ end }}"}

{{ if $relboron }}
    - network:
        poll-interval: 1000
        content:
          map:
            default: {empty: {}}
            conditions:
              name == wlan0:
                map:
                  default: {empty: {}}
                  conditions:
                    state == up && ipv4 != "":
                    - string: {text: "{ul-speed:mb}"}
{{ end }}
{{ end }}

  center:
    - clock:
        time-format: "%H:%M:%S"
        date-format: "%b %d %a"
        content:
          string: {text: "{date}  {time}", font: "UbuntuMono Nerd Font:size={{ if $bigSize }}64{{ else }}32{{ end }}"}


  right:

    - label:
        content:
          string: {text: mic, foreground: *prompt_color, font: *prompt_font}
    - pipewire:
        content:
          map:
            conditions:
              type == "source":
                map:
                  default:
                    - string: {text: "{cubic_volume}%"}
                  conditions:
                    muted:
                      - string: {text: "mute", foreground: *gray}
                    cubic_volume == 0:
                      - string: {text: "0%", foreground: *gray}
                    cubic_volume > 100:
                      - string: {text: "{cubic_volume}%", foreground: *yellow}

    - *delimiter

    - label:
        content:
          string: {text: vol, foreground: *prompt_color, font: *prompt_font}
    - pipewire:
        content:
          map:
            conditions:
              type == "sink":
                map:
                  default:
                    - string: {text: "{cubic_volume}%"}
                  conditions:
                    muted:
                      - string: {text: "mute", foreground: *gray}
                    cubic_volume == 0:
                      - string: {text: "0%", foreground: *gray}
                    cubic_volume > 100:
                      - string: {text: "{cubic_volume}%", foreground: *yellow}

{{ if $hasBattery }}
    - *delimiter

    - label:
        content:
          string: {text: bri, foreground: *prompt_color, font: *prompt_font}
    - backlight:
        name: intel_backlight
        content:
          - string: {text: "{percent}%"}

    - *delimiter

    - label:
        content:
          string: {text: bat, foreground: *prompt_color, font: *prompt_font}
    - battery:
        name: BAT0
        poll-interval: 10000
        content:
          map:
            default:
              map:
                default:
                  - string: {text: "{capacity}%"}
                conditions:
                  capacity < 10:
                    - string: {text: "{capacity}%", foreground: *red}
                  capacity <= 30:
                    - string: {text: "{capacity}%", foreground: *red}
                  capacity <= 60:
                    - string: {text: "{capacity}%", foreground: *yellow}
            conditions:
              state == charging:
                - string: {text: "{capacity}%", foreground: *green}
{{ end }}
